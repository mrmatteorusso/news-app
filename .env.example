APP_ENV=local
APP_TIMEZONE=Europe/Rome
APP_PORT=8080
FINANCE_CACHE_MINUTES=60
MARKET_HISTORY_REFRESH_HOURS=168
ARTICLE_RETENTION_DAYS=90

# Used from Stage 5. LM Studio runs on Windows, outside Docker.
LLM_BASE_URL=http://host.docker.internal:1234/v1
LLM_MODEL=gemma-3-4b-it
LLM_ENABLED=true
# Leave blank unless LM Studio authentication is enabled.
LLM_API_KEY=
LLM_CONNECT_TIMEOUT_SECONDS=3
LLM_REQUEST_TIMEOUT_SECONDS=180
LLM_RETRY_AFTER_MINUTES=10
LLM_MAX_CANDIDATES=10
LLM_CHUNK_SIZE=8
LLM_MAX_OUTPUT_TOKENS=420
